# TrafficWatch: NVIDIA GPU image (CUDA 13 + cuDNN 9). Requires the NVIDIA Container Toolkit
# (or Docker Desktop with WSL2 GPU support). A GPU is optional; see README.

FROM python:3.12-slim AS models
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir torch==2.14.1 torchvision --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir ultralytics==8.4.178 onnx onnxslim
WORKDIR /export
COPY scripts/export_models.py .
ARG MODELS=yolo11n,yolo11s,yolo11m,yolo26n,yolo26s,yolo26m
RUN python export_models.py /models "$MODELS"

FROM node:22-slim AS ui
WORKDIR /ui
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM nvidia/cuda:13.0.1-cudnn-runtime-ubuntu24.04
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv && rm -rf /var/lib/apt/lists/*
ENV PYTHONUNBUFFERED=1 TW_DATA_DIR=/data TW_MODELS_DIR=/app/models TW_STATIC_DIR=/app/static PATH=/venv/bin:$PATH
WORKDIR /app
COPY backend/requirements.txt .
RUN python3 -m venv /venv \
 && grep -v '^onnxruntime' requirements.txt > req-gpu.txt \
 && pip install --no-cache-dir -r req-gpu.txt onnxruntime-gpu==1.31.0
COPY backend/app ./app
COPY --from=models /models ./models
COPY --from=ui /ui/dist ./static
VOLUME /data
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/api/health')"
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080"]
